{%- comment -%}
  "Notify me when it's back" — captures demand on sold-out variants instead of
  losing the visit. Uses Shopify's built-in contact form, so it needs no app:
  the request lands in the shop's inbox with the product, variant and SKU.

  Usage (product page, inside the buy column):
    {% render 'back-in-stock', product: product, variant: current_variant %}

  Renders nothing when the variant is purchasable.
{%- endcomment -%}

{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign show = false
  if product != blank and target != blank and target.available == false
    assign show = true
  endif
-%}

{%- if show -%}
  {%- assign form_id = 'BackInStock-' | append: target.id -%}
  <div class="back-in-stock" data-back-in-stock>
    <div class="back-in-stock__head">
      {% render 'icon', name: 'alert', size: 20 %}
      <div>
        <p class="back-in-stock__title">{{ 'products.product.sold_out' | t }}</p>
        <p class="back-in-stock__text text-meta">
          נשלח לכם הודעה ברגע שהמוצר חוזר למלאי - בלי התחייבות.
        </p>
      </div>
    </div>

    {%- comment -%}
      `form.name == blank` is the mirror of the guard in request-price.liquid: the
      contact form object is page-scoped, and the quote form on the same product
      page posts contact[שם]. Without this, submitting a quote request also printed
      "תודה! נעדכן אתכם במייל" here — a promise nobody asked for.
    {%- endcomment -%}
    {%- form 'contact', id: form_id, class: 'back-in-stock__form' -%}
      {%- if form.posted_successfully? and form.name == blank -%}
        <p class="form__success" role="status">
          {% render 'icon', name: 'check-circle', size: 18 %}
          תודה! נעדכן אתכם במייל ברגע שהמוצר חוזר למלאי.
        </p>
      {%- else -%}
        {%- if form.errors and form.name == blank -%}
          <div class="errors" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <input type="hidden" name="contact[נושא]" value="בקשת עדכון חזרה למלאי">
        <input type="hidden" name="contact[מוצר]" value="{{ product.title | escape }}">
        {%- if target.title != 'Default Title' -%}
          <input type="hidden" name="contact[וריאנט]" value="{{ target.title | escape }}">
        {%- endif -%}
        {%- if target.sku != blank -%}
          <input type="hidden" name="contact[מקט]" value="{{ target.sku | escape }}">
        {%- endif -%}
        <input type="hidden" name="contact[קישור]" value="{{ shop.url }}{{ product.url }}?variant={{ target.id }}">

        <div class="back-in-stock__row">
          <label class="visually-hidden" for="{{ form_id }}-email">כתובת אימייל</label>
          <input
            id="{{ form_id }}-email"
            class="field__input"
            type="email"
            name="contact[email]"
            value="{{ form.email | default: customer.email }}"
            placeholder="האימייל שלכם"
            autocomplete="email"
            required
          >
          <button type="submit" class="btn btn--secondary">
            {% render 'icon', name: 'mail', size: 17 %}
            עדכנו אותי
          </button>
        </div>

        {%- comment -%}
          A collection notice at the point of collection. This form takes an email
          address and files it, with the product and SKU, in the shop inbox for
          later outreach — and said nothing about who holds it, why, that giving it
          is voluntary, or how to have it removed. Israel's Privacy Protection Law
          as amended by Amendment 13 (in force August 2025) expects that notice
          where the data is collected. The policy URL comes from the shop's own
          policy so it cannot drift.
        {%- endcomment -%}
        {%- if shop.privacy_policy.url != blank -%}
          <p class="back-in-stock__privacy text-meta">
            {{- 'general.privacy.collection_notice_html' | t | replace: '[url]', shop.privacy_policy.url -}}
          </p>
        {%- endif -%}

        {%- if settings.store_whatsapp != blank -%}
          {%- liquid
            assign wa = settings.store_whatsapp
            unless wa contains 'http'
              assign wa_digits = wa | remove: '+' | remove: '-' | remove: ' '
              assign wa = 'https://wa.me/' | append: wa_digits
            endunless
            assign wa_message = 'שלום, אני מחפש את המוצר: ' | append: product.title
            if target.sku != blank
              assign wa_message = wa_message | append: ' (מקט ' | append: target.sku | append: ')'
            endif
            assign wa_message = wa_message | append: ' - יש במחסן?'
            comment
              url_encode has to be applied to the MESSAGE, not to the finished
              URL. Liquid pipes left to right, so
              `wa | append: '?text=' | append: wa_message | url_encode` encoded
              the whole thing — scheme and slashes included — producing
              "https%3A%2F%2Fwa.me%2F972…", which the browser then resolved as a
              relative path against the product URL and served a 404. Every
              sold-out product had a dead WhatsApp link.
              sections/main-product.liquid:44 and sections/footer.liquid:203 both
              get the order right; this was the one slip.
            endcomment
            assign wa_query = wa_message | url_encode
            if wa contains '?'
              assign wa_link = wa | append: '&text=' | append: wa_query
            else
              assign wa_link = wa | append: '?text=' | append: wa_query
            endif
          -%}
          <p class="back-in-stock__alt text-meta">
            צריכים את זה עכשיו?
            <a class="link" href="{{ wa_link }}" target="_blank" rel="noopener">בדקו איתנו במחסן בוואטסאפ</a>
            {%- if settings.store_phone != blank -%}
              או בטלפון <a class="link" dir="ltr" href="tel:{{ settings.store_phone | remove: '-' | remove: ' ' }}">{{ settings.store_phone }}</a>
            {%- endif -%}
          </p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
{%- endif -%}
