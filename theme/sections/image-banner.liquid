{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign img = section.settings.image
  assign mobile_img = section.settings.mobile_image
  assign overlay = section.settings.overlay_opacity | divided_by: 100.0

  assign btn2_link = section.settings.button_2_link
  if btn2_link == blank and settings.store_phone != blank
    assign btn2_link = 'tel:' | append: settings.store_phone
  endif

  assign has_chips = false
  if section.settings.chip_1 != blank or section.settings.chip_2 != blank or section.settings.chip_3 != blank
    assign has_chips = true
  endif
-%}

<div
  id="ImageBanner-{{ section.id }}"
  class="image-banner image-banner--{{ section.settings.height }} image-banner--align-{{ section.settings.alignment }}{% if img == blank %} image-banner--no-image{% endif %}"
  style="--overlay-opacity: {{ overlay }};"
>
  {%- if img != blank -%}
    <picture class="image-banner__media">
      {%- if mobile_img != blank -%}
        <source
          media="(max-width: 749px)"
          srcset="{{ mobile_img | image_url: width: 450 }} 450w, {{ mobile_img | image_url: width: 750 }} 750w, {{ mobile_img | image_url: width: 1100 }} 1100w"
        >
      {%- endif -%}
      <img
        src="{{ img | image_url: width: 1780 }}"
        srcset="{{ img | image_url: width: 750 }} 750w, {{ img | image_url: width: 1100 }} 1100w, {{ img | image_url: width: 1500 }} 1500w, {{ img | image_url: width: 1780 }} 1780w, {{ img | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        width="{{ img.width }}"
        height="{{ img.height }}"
        alt="{{ img.alt | escape }}"
        loading="eager"
        fetchpriority="high"
      >
    </picture>
    <span class="image-banner__overlay" aria-hidden="true"></span>
  {%- else -%}
    <span class="image-banner__ornament image-banner__ornament--glow" aria-hidden="true"></span>
    <span class="image-banner__ornament image-banner__ornament--grid" aria-hidden="true"></span>
    <span class="image-banner__ornament image-banner__ornament--hazard" aria-hidden="true"></span>
  {%- endif -%}
  <span class="image-banner__scrim" aria-hidden="true"></span>

  <div class="container image-banner__container">
    <div class="image-banner__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="image-banner__eyebrow reveal">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="image-banner__heading reveal">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="image-banner__subheading reveal">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
        <div class="image-banner__actions reveal">
          {%- if section.settings.button_1_label != blank -%}
            <a href="{{ section.settings.button_1_link | default: routes.all_products_collection_url }}" class="btn btn--lg">
              {{- section.settings.button_1_label | escape -}}
            </a>
          {%- endif -%}
          {%- if section.settings.button_2_label != blank and btn2_link != blank -%}
            <a href="{{ btn2_link }}" class="btn btn--outline-light btn--lg">
              {{- section.settings.button_2_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_chips and has_chips -%}
        <ul class="image-banner__chips reveal" role="list">
          {%- if section.settings.chip_1 != blank -%}
            <li class="image-banner__chip">
              {%- render 'icon', name: 'check-circle', size: 16 -%}
              <span>{{ section.settings.chip_1 | escape }}</span>
            </li>
          {%- endif -%}
          {%- if section.settings.chip_2 != blank -%}
            <li class="image-banner__chip">
              {%- render 'icon', name: 'truck', size: 16 -%}
              <span>{{ section.settings.chip_2 | escape }}</span>
            </li>
          {%- endif -%}
          {%- if section.settings.chip_3 != blank -%}
            <li class="image-banner__chip">
              {%- render 'icon', name: 'headset', size: 16 -%}
              <span>{{ section.settings.chip_3 | escape }}</span>
            </li>
          {%- endif -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "באנר תמונה",
  "settings": [
    {
      "type": "header",
      "content": "תמונה"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "תמונת רקע",
      "info": "מומלץ 2400×1200 לפחות. ללא תמונה יוצג רקע תעשייתי ממותג."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "תמונה למובייל (אופציונלי)"
    },
    {
      "type": "select",
      "id": "height",
      "label": "גובה הבאנר",
      "options": [
        { "value": "small", "label": "נמוך" },
        { "value": "medium", "label": "בינוני" },
        { "value": "large", "label": "גבוה" },
        { "value": "full", "label": "מסך מלא" }
      ],
      "default": "large"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "כהות שכבת ההצללה",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "header",
      "content": "תוכן"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "שורת פתיחה קטנה",
      "default": "א.נ. שילו — חומרי בניין וכלי עבודה"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "כותרת",
      "default": "כל מה שהמקצוענים צריכים. במקום אחד."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "כותרת משנה",
      "default": "יותר מ־30 שנה שאנחנו מלווים קבלנים, אנשי מקצוע ובעלי בתים בכל הצפון — עם הכלים, הצבעים והחומרים הטובים בשוק."
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "יישור התוכן",
      "options": [
        { "value": "start", "label": "לצד ההתחלה" },
        { "value": "center", "label": "מרכז" }
      ],
      "default": "start"
    },
    {
      "type": "header",
      "content": "כפתורים"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "כפתור ראשי — טקסט",
      "default": "לקטלוג המלא"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "כפתור ראשי — קישור",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "כפתור משני — טקסט",
      "default": "דברו איתנו"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "כפתור משני — קישור",
      "info": "אם נשאר ריק — יקושר לטלפון החנות מהגדרות ערכת העיצוב."
    },
    {
      "type": "header",
      "content": "חותמות אמון"
    },
    {
      "type": "checkbox",
      "id": "show_chips",
      "label": "הצגת שורת חותמות אמון",
      "default": true
    },
    {
      "type": "text",
      "id": "chip_1",
      "label": "חותמת 1",
      "default": "30+ שנות ניסיון"
    },
    {
      "type": "text",
      "id": "chip_2",
      "label": "חותמת 2",
      "default": "משלוחים עד האתר"
    },
    {
      "type": "text",
      "id": "chip_3",
      "label": "חותמת 3",
      "default": "ייעוץ מקצועי חינם"
    }
  ],
  "presets": [
    {
      "name": "באנר תמונה"
    }
  ]
}
{% endschema %}
