{{ 'section-image-with-text.css' | asset_url | stylesheet_tag }}

<section
  id="ImageWithText-{{ section.id }}"
  class="section{% if section.settings.alt_background %} section--alt{% endif %}"
>
  <div class="container">
    <div class="image-text{% if section.settings.flip %} image-text--flip{% endif %}">
      <div class="image-text__media-wrap reveal">
        <div class="image-text__media media">
          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 900 }}"
              srcset="{{ section.settings.image | image_url: width: 450 }} 450w, {{ section.settings.image | image_url: width: 750 }} 750w, {{ section.settings.image | image_url: width: 900 }} 900w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
              sizes="(min-width: 990px) 50vw, (min-width: 750px) 50vw, 100vw"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              alt="{{ section.settings.image.alt | escape }}"
              loading="lazy"
            >
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>

      <div class="image-text__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="section-header__eyebrow reveal">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="image-text__heading reveal">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="image-text__text rte reveal">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div class="image-text__actions reveal">
            <a class="btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
              {{- section.settings.button_label | escape -}}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "תמונה עם טקסט",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "תמונה",
      "info": "מומלץ יחס 4:3, רוחב 1200px לפחות"
    },
    {
      "type": "checkbox",
      "id": "flip",
      "label": "החלפת צדדים (תמונה בצד השני)",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "שורת פתיחה קטנה",
      "default": "הסיפור שלנו"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "כותרת",
      "default": "מחסן העצים הגדול בצפון"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "טקסט",
      "default": "<p>במחסן העצים שלנו תמצאו מבחר ענק של עץ גושני, לוחות, קורות ופרופילים — עם חיתוך מדויק במידה לפי דרישה. הצוות שלנו ילווה אתכם משלב התכנון ועד ההעמסה על הרכב, כמו שעושים כבר יותר מ־30 שנה.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "טקסט כפתור",
      "default": "לצפייה בקטלוג"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "קישור כפתור",
      "default": "/collections/all"
    },
    {
      "type": "checkbox",
      "id": "alt_background",
      "label": "רקע אפור בהיר",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "תמונה עם טקסט"
    }
  ]
}
{% endschema %}
