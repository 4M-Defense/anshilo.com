{{ 'section-featured-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign coll = section.settings.collection
  assign limit = section.settings.products_limit
  assign columns = section.settings.columns

  assign has_products = false
  if coll != blank and coll.products.size > 0
    assign has_products = true
  endif

  assign row_class = 'scroll-row featured-collection__row'
  if section.settings.scroll_desktop
    assign row_class = row_class | append: ' featured-collection__row--scroll'
  else
    assign row_class = row_class | append: ' featured-collection__row--grid'
  endif

  assign view_all_url = coll.url | default: routes.all_products_collection_url
-%}

<section
  id="FeaturedCollection-{{ section.id }}"
  class="section featured-collection{% if section.settings.alt_background %} section--alt{% endif %}"
>
  <div class="container">
    <div class="section-header">
      <div class="section-header__titles">
        {%- if section.settings.eyebrow != blank -%}
          <span class="section-header__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="featured-collection__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>

      {%- if section.settings.show_view_all -%}
        <a href="{{ view_all_url }}" class="section-header__link">
          {{ 'sections.featured_collection.view_all' | t }}
          {% render 'icon', name: 'arrow-right', size: 18 %}
        </a>
      {%- endif -%}
    </div>

    <ul
      class="{{ row_class }}"
      style="--fc-columns: {{ columns }};"
      role="list"
    >
      {%- if has_products -%}
        {%- for product in coll.products limit: limit -%}
          <li class="featured-collection__item">
            {% render 'product-card', product: product, class: 'reveal', lazy: true %}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          {%- assign ph_index = forloop.index0 | modulo: 6 | plus: 1 -%}
          <li class="featured-collection__item">
            {% render 'product-card', product: blank, class: 'reveal', placeholder_index: ph_index %}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if section.settings.show_view_all -%}
      <div class="featured-collection__footer">
        <a href="{{ view_all_url }}" class="btn btn--outline">
          {{ 'sections.featured_collection.view_all' | t }}
          {% render 'icon', name: 'arrow-right', size: 18, class: 'icon--dir' %}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "קולקציה מומלצת",
  "settings": [
    {
      "type": "header",
      "content": "כותרת"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "שורת פתיחה קטנה",
      "default": "הבחירה של המקצוענים"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "כותרת",
      "default": "הנמכרים ביותר"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "הצגת קישור \"לכל המוצרים\"",
      "default": true
    },
    {
      "type": "header",
      "content": "מוצרים"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "קולקציה",
      "info": "כשלא נבחרה קולקציה יוצגו כרטיסי דוגמה."
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "מספר מוצרים מקסימלי",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "פריסה"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "עמודות במחשב",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "scroll_desktop",
      "label": "גלילה אופקית גם במחשב",
      "info": "במובייל המוצרים תמיד מוצגים בשורה נגללת.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "alt_background",
      "label": "רקע אפור בהיר",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "קולקציה מומלצת"
    }
  ]
}
{% endschema %}
