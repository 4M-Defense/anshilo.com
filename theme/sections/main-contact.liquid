{{ 'section-contact.css' | asset_url | stylesheet_tag }}

<section class="section contact-section">
  <div class="container">
    <header class="contact-section__header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-header__eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h1 class="hazard-underline">{{ section.settings.heading | default: page.title | escape }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="contact-section__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </header>

    <div class="contact-layout">
      {%- # ---------- Form column ---------- -%}
      <div class="contact-form-wrap">
        {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="form__success" role="status" tabindex="-1" autofocus>
              {% render 'icon', name: 'check-circle', size: 22 %}
              {{ 'general.contact.success' | t }}
            </div>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="errors" role="alert" tabindex="-1" autofocus>
              <p class="fw-700">{{ 'general.contact.error' | t }}</p>
              <ul>
                {%- for field in form.errors -%}
                  <li>{{ form.errors.translated_fields[field] }} — {{ form.errors.messages[field] }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="form__row form__row--2">
            <div class="field">
              <label class="field__label" for="ContactFormName">
                {{ 'general.contact.name' | t }} <span class="required" aria-hidden="true">*</span>
              </label>
              <input
                class="field__input"
                type="text"
                id="ContactFormName"
                name="contact[name]"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                autocomplete="name"
                required
              >
            </div>

            <div class="field">
              <label class="field__label" for="ContactFormPhone">{{ 'general.contact.phone' | t }}</label>
              <input
                class="field__input"
                type="tel"
                id="ContactFormPhone"
                name="contact[phone]"
                value="{{ form.phone }}"
                autocomplete="tel"
                pattern="[0-9\-+() ]*"
              >
            </div>
          </div>

          <div class="field">
            <label class="field__label" for="ContactFormEmail">
              {{ 'general.contact.email' | t }} <span class="required" aria-hidden="true">*</span>
            </label>
            <input
              class="field__input"
              type="email"
              id="ContactFormEmail"
              name="contact[email]"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              autocomplete="email"
              spellcheck="false"
              autocapitalize="off"
              required
              {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
            >
          </div>

          <div class="field">
            <label class="field__label" for="ContactFormMessage">
              {{ 'general.contact.message' | t }} <span class="required" aria-hidden="true">*</span>
            </label>
            <textarea
              class="field__textarea"
              id="ContactFormMessage"
              name="contact[body]"
              rows="6"
              required
            >{{ form.body }}</textarea>
          </div>

          <div class="contact-form__submit">
            <button type="submit" class="btn btn--lg">
              {{ 'general.contact.send' | t }}
              {% render 'icon', name: 'arrow-right', size: 18, class: 'icon--dir' %}
            </button>
          </div>
        {%- endform -%}
      </div>

      {%- # ---------- Info card column ---------- -%}
      <aside class="contact-card" aria-label="{{ section.settings.card_heading | escape }}">
        <h2 class="contact-card__heading h3">{{ section.settings.card_heading | escape }}</h2>

        <ul class="contact-card__list" role="list">
          {%- if settings.store_phone != blank -%}
            <li class="contact-card__row">
              <span class="contact-card__icon">{% render 'icon', name: 'phone', size: 19 %}</span>
              <span class="contact-card__info">
                <span class="contact-card__label">{{ 'general.contact.phone' | t }}</span>
                <a class="contact-card__value" href="tel:{{ settings.store_phone | remove: '-' | remove: ' ' }}" dir="ltr">{{ settings.store_phone }}</a>
              </span>
            </li>
          {%- endif -%}

          {%- if settings.store_email != blank -%}
            <li class="contact-card__row">
              <span class="contact-card__icon">{% render 'icon', name: 'mail', size: 19 %}</span>
              <span class="contact-card__info">
                <span class="contact-card__label">{{ 'general.contact.email' | t }}</span>
                <a class="contact-card__value" href="mailto:{{ settings.store_email }}" dir="ltr">{{ settings.store_email }}</a>
              </span>
            </li>
          {%- endif -%}

          {%- if settings.store_address != blank -%}
            <li class="contact-card__row">
              <span class="contact-card__icon">{% render 'icon', name: 'map-pin', size: 19 %}</span>
              <span class="contact-card__info">
                <!-- TODO-i18n: general.contact.address -->
                <span class="contact-card__label">כתובת</span>
                <a
                  class="contact-card__value"
                  href="https://www.google.com/maps/search/?api=1&query={{ settings.store_address | url_param_escape }}"
                  target="_blank"
                  rel="noopener"
                >
                  {{ settings.store_address }}
                  <span class="visually-hidden">{{ 'general.accessibility.link_opens_new_tab' | t }}</span>
                </a>
              </span>
            </li>
          {%- endif -%}

          {%- if settings.store_hours != blank -%}
            <li class="contact-card__row">
              <span class="contact-card__icon">{% render 'icon', name: 'clock', size: 19 %}</span>
              <span class="contact-card__info">
                <!-- TODO-i18n: general.contact.hours -->
                <span class="contact-card__label">שעות פעילות</span>
                <span class="contact-card__value contact-card__hours">{{ settings.store_hours | newline_to_br }}</span>
              </span>
            </li>
          {%- endif -%}
        </ul>

        {%- if settings.store_whatsapp != blank -%}
          <a
            class="btn btn--full contact-card__whatsapp"
            href="https://wa.me/{{ settings.store_whatsapp | remove: '+' | remove: '-' | remove: ' ' }}"
            target="_blank"
            rel="noopener"
          >
            {% render 'icon', name: 'whatsapp', size: 20 %}
            <!-- TODO-i18n: general.contact.whatsapp_cta -->
            דברו איתנו בוואטסאפ
            <span class="visually-hidden">{{ 'general.accessibility.link_opens_new_tab' | t }}</span>
          </a>
        {%- endif -%}

        {%- assign has_social = false -%}
        {%- if settings.social_facebook != blank or settings.social_instagram != blank or settings.social_tiktok != blank or settings.social_youtube != blank -%}
          {%- assign has_social = true -%}
        {%- endif -%}

        {%- if has_social -%}
          <div class="contact-card__social">
            <span class="contact-card__label">{{ 'general.social.follow_title' | t }}</span>
            <div class="contact-card__social-icons">
              {%- if settings.social_facebook != blank -%}
                <a class="contact-card__social-link" href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.facebook' | t }}">
                  {% render 'icon', name: 'facebook', size: 19 %}
                </a>
              {%- endif -%}
              {%- if settings.social_instagram != blank -%}
                <a class="contact-card__social-link" href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.instagram' | t }}">
                  {% render 'icon', name: 'instagram', size: 19 %}
                </a>
              {%- endif -%}
              {%- if settings.social_tiktok != blank -%}
                <a class="contact-card__social-link" href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.tiktok' | t }}">
                  {% render 'icon', name: 'tiktok', size: 19 %}
                </a>
              {%- endif -%}
              {%- if settings.social_youtube != blank -%}
                <a class="contact-card__social-link" href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.youtube' | t }}">
                  {% render 'icon', name: 'youtube', size: 19 %}
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </aside>
    </div>

    {%- if section.settings.map_embed != blank -%}
      <div class="contact-map">
        {{ section.settings.map_embed }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "עמוד צור קשר",
  "settings": [
    {
      "type": "header",
      "content": "כותרת"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "שורת פתיחה קטנה",
      "default": "נשמח לעזור"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "כותרת",
      "default": "צרו קשר"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "טקסט פתיחה",
      "default": "יש לכם שאלה על מוצר, מלאי או הזמנה? השאירו הודעה או התקשרו — צוות המומחים שלנו כאן בשבילכם."
    },
    {
      "type": "header",
      "content": "כרטיס פרטי התקשרות",
      "info": "הפרטים עצמם (טלפון, כתובת, שעות פעילות ורשתות חברתיות) מוגדרים בהגדרות התבנית."
    },
    {
      "type": "text",
      "id": "card_heading",
      "label": "כותרת הכרטיס",
      "default": "פרטי התקשרות"
    },
    {
      "type": "header",
      "content": "מפה"
    },
    {
      "type": "textarea",
      "id": "map_embed",
      "label": "קוד הטמעה למפה (iframe)",
      "info": "הדביקו כאן קוד הטמעה מגוגל מפות. השאירו ריק כדי להסתיר.",
      "default": ""
    }
  ]
}
{% endschema %}
