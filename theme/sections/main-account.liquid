{{ 'section-customers.css' | asset_url | stylesheet_tag }}

<section class="section account-section">
  <div class="container">
    {%- paginate customer.orders by 10 -%}
      <header class="account-header">
        <div>
          <span class="section-header__eyebrow">{{ 'customer.account.title' | t }}</span>
          <h1 class="hazard-underline">
            {%- assign customer_name = customer.first_name | default: customer.name -%}
            {{ 'customer.account.welcome' | t: name: customer_name }}
          </h1>
        </div>
        <a class="btn btn--ghost btn--sm" href="{{ routes.account_logout_url }}">
          {{ 'customer.account.log_out' | t }}
        </a>
      </header>

      <div class="account-layout">
        {%- # ---------- Account details card ---------- -%}
        <aside class="account-card">
          <h2 class="account-card__title">
            {% render 'icon', name: 'user', size: 20 %}
            {{ 'customer.account.details' | t }}
          </h2>

          <div class="account-card__row">
            <span class="account-card__label">{{ 'general.contact.name' | t }}</span>
            <span class="account-card__value">{{ customer.name }}</span>
          </div>

          <div class="account-card__row">
            <span class="account-card__label">{{ 'customer.login_page.email' | t }}</span>
            <span class="account-card__value">{{ customer.email }}</span>
          </div>

          {%- if customer.default_address -%}
            <div class="account-card__row">
              <span class="account-card__label">{{ 'customer.addresses.default' | t }}</span>
              <span class="account-card__value">
                <address>{{ customer.default_address | format_address }}</address>
              </span>
            </div>
          {%- endif -%}

          <a class="btn btn--outline btn--full" href="{{ routes.account_addresses_url }}">
            {% render 'icon', name: 'map-pin', size: 18 %}
            {{ 'customer.account.view_addresses' | t }} ({{ customer.addresses_count }})
          </a>
        </aside>

        {%- # ---------- Orders ---------- -%}
        <div class="account-orders">
          <div class="account-orders__head">
            <h2 class="h3">{{ 'customer.orders.title' | t }}</h2>
            {%- if customer.orders_count > 0 -%}
              <span class="badge badge--outline">{{ customer.orders_count }}</span>
            {%- endif -%}
          </div>

          {%- if customer.orders.size > 0 -%}
            <div class="table-wrap">
              <table class="table table--stack orders-table">
                <caption class="visually-hidden">{{ 'customer.orders.title' | t }}</caption>
                <thead>
                  <tr>
                    <th scope="col">{{ 'customer.orders.order_number' | t }}</th>
                    <th scope="col">{{ 'customer.orders.date' | t }}</th>
                    <th scope="col">{{ 'customer.orders.payment_status' | t }}</th>
                    <th scope="col">{{ 'customer.orders.fulfillment_status' | t }}</th>
                    <th scope="col">{{ 'customer.orders.total' | t }}</th>
                  </tr>
                </thead>
                <tbody>
                  {%- for order in customer.orders -%}
                    {%- liquid
                      case order.financial_status
                        when 'paid', 'partially_refunded'
                          assign fin_class = 'status-pill--success'
                        when 'pending', 'authorized', 'partially_paid'
                          assign fin_class = 'status-pill--pending'
                        when 'refunded', 'voided'
                          assign fin_class = ''
                        else
                          assign fin_class = ''
                      endcase

                      case order.fulfillment_status
                        when 'fulfilled'
                          assign ful_class = 'status-pill--success'
                        when 'partial'
                          assign ful_class = 'status-pill--pending'
                        else
                          assign ful_class = ''
                      endcase
                    -%}
                    <tr>
                      <td data-label="{{ 'customer.orders.order_number' | t }}">
                        <a
                          class="orders-table__link"
                          href="{{ order.customer_url }}"
                          aria-label="{{ 'customer.orders.order_number_link' | t: number: order.name }}"
                        >{{ order.name }}</a>
                      </td>
                      <td data-label="{{ 'customer.orders.date' | t }}">
                        {{ order.created_at | date: '%d.%m.%Y' }}
                      </td>
                      <td data-label="{{ 'customer.orders.payment_status' | t }}">
                        <span class="status-pill {{ fin_class }}">{{ order.financial_status_label }}</span>
                      </td>
                      <td data-label="{{ 'customer.orders.fulfillment_status' | t }}">
                        <span class="status-pill {{ ful_class }}">{{ order.fulfillment_status_label }}</span>
                      </td>
                      <td data-label="{{ 'customer.orders.total' | t }}" class="orders-table__total">
                        {{ order.total_price | money }}
                      </td>
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
            </div>

            {% render 'pagination', paginate: paginate %}
          {%- else -%}
            <div class="empty-state">
              {% render 'icon', name: 'package', size: 48 %}
              <h3 class="empty-state__title h4">{{ 'customer.orders.none' | t }}</h3>
              <a class="btn" href="{{ routes.all_products_collection_url }}">
                {{ 'general.continue_shopping' | t }}
                {% render 'icon', name: 'arrow-right', size: 16, class: 'icon--dir' %}
              </a>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "האזור האישי",
  "settings": []
}
{% endschema %}
