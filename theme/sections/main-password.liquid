{{ 'section-customers.css' | asset_url | stylesheet_tag }}

<div class="password-page">
  <div class="hazard-divider password-page__stripe" aria-hidden="true"></div>

  <header class="password-head">
    {%- if settings.logo != blank -%}
      {%- assign logo_width = settings.logo_width | default: 160 -%}
      {%- assign logo_width_2x = logo_width | times: 2 -%}
      <img
        class="password-logo"
        src="{{ settings.logo | image_url: width: logo_width_2x }}"
        alt="{{ shop.name | escape }}"
        width="{{ logo_width }}"
        height="{{ logo_width | divided_by: settings.logo.aspect_ratio | round }}"
      >
    {%- else -%}
      <span class="password-shopname">{{ shop.name }}</span>
    {%- endif -%}
  </header>

  <div class="password-main">
    <h1 class="password-title">{{ 'general.password_page.title' | t }}</h1>
    <p class="password-subtitle">{{ 'general.password_page.subtitle' | t }}</p>
  </div>

  <div class="auth-card password-card">
    <h2 class="password-card__heading h4">
      {% render 'icon', name: 'shield-check', size: 20 %}
      {{ 'general.password_page.login_form_heading' | t }}
    </h2>

    {%- form 'storefront_password', class: 'customer-form' -%}
      {%- if form.errors -%}
        <div class="errors" role="alert" tabindex="-1">
          <ul>
            {%- for field in form.errors -%}
              <li>{{ form.errors.messages[field] }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="field">
        <label class="field__label" for="StorefrontPassword">
          {{ 'general.password_page.login_form_password_label' | t }}
        </label>
        <input
          class="field__input"
          type="password"
          id="StorefrontPassword"
          name="password"
          placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
          autocomplete="current-password"
          required
          {% if form.errors %}aria-invalid="true"{% endif %}
        >
      </div>

      <button type="submit" class="btn btn--full auth-submit">
        {{ 'general.password_page.login_form_submit' | t }}
      </button>
    {%- endform -%}
  </div>

  <footer class="password-footer">
    <p>{{ 'general.password_page.admin_link_html' | t }}</p>
    {%- if settings.store_phone != blank -%}
      <a href="tel:{{ settings.store_phone | remove: '-' | remove: ' ' }}" dir="ltr">{{ settings.store_phone }}</a>
    {%- endif -%}
  </footer>
</div>

{% schema %}
{
  "name": "עמוד סיסמה",
  "settings": []
}
{% endschema %}
