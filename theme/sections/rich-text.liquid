<section
  id="RichText-{{ section.id }}"
  class="section{% if section.settings.alt_background %} section--alt{% endif %}"
>
  <div class="container {% if section.settings.width == 'narrow' %}container--text{% else %}container--narrow{% endif %}">
    <div class="rich-text-block">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-header__eyebrow reveal">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="rich-text-block__heading reveal">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="rte reveal">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="btn btn--outline rich-text-block__btn reveal" href="{{ section.settings.button_link }}">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  #RichText-{{ section.id }} .rich-text-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }
  #RichText-{{ section.id }} .rich-text-block__heading {
    margin: 0;
    text-wrap: balance;
  }
  #RichText-{{ section.id }} .rte {
    line-height: 1.8;
  }
  #RichText-{{ section.id }} .rich-text-block__btn {
    margin-block-start: 0.5rem;
  }
{% endstyle %}

{% schema %}
{
  "name": "טקסט עשיר",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "שורת פתיחה קטנה",
      "default": "מאז 1990"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "כותרת",
      "default": "יותר מ־30 שנה של מקצועיות, אמינות ושירות"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "טקסט",
      "default": "<p>א.נ. שילו היא הבית של אנשי המקצוע בצפון: חנות ומחסן של חומרי בניין, כלי עבודה, צבעים ועצים — עם צוות שמכיר כל מוצר מהשטח. אצלנו תמצאו את המותגים המובילים בעולם, מחירים הוגנים ושירות אישי שרואים רק בעסק משפחתי.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "טקסט כפתור (אופציונלי)"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "קישור כפתור"
    },
    {
      "type": "select",
      "id": "width",
      "label": "רוחב התוכן",
      "options": [
        { "value": "narrow", "label": "צר" },
        { "value": "normal", "label": "רגיל" }
      ],
      "default": "normal"
    },
    {
      "type": "checkbox",
      "id": "alt_background",
      "label": "רקע אפור בהיר",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "טקסט עשיר"
    }
  ]
}
{% endschema %}
