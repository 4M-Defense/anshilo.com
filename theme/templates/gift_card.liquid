{% layout none %}
{%- liquid
  assign rtl_locales = 'he,ar'
  assign is_rtl = false
  if rtl_locales contains request.locale.iso_code
    assign is_rtl = true
  endif

  assign formatted_balance = gift_card.balance | money
  assign formatted_initial = gift_card.initial_value | money

  assign is_expired = false
  if gift_card.expired or gift_card.enabled != true
    assign is_expired = true
  endif
-%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" {% if is_rtl %}dir="rtl"{% else %}dir="ltr"{% endif %}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex">
    <title>{{ 'gift_cards.issued.title' | t }} &ndash; {{ shop.name }}</title>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
    {%- endif -%}

    {{ content_for_header }}

    <style>
      {{ settings.font_body | font_face: font_display: 'swap' }}
      {%- assign body_font_bold = settings.font_body | font_modify: 'weight', '700' -%}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ settings.font_heading | font_face: font_display: 'swap' }}

      :root {
        --accent: {{ settings.color_accent | default: '#e8a020' }};
        --accent-rgb: {{ settings.color_accent.rgb | replace: ' ', ', ' | default: '232, 160, 32' }};
        --ink: {{ settings.color_ink | default: '#14181d' }};
        --success: {{ settings.color_success | default: '#178a50' }};
        --danger: {{ settings.color_danger | default: '#d93025' }};
        --font-body: {{ settings.font_body.family }}, "Heebo", "Segoe UI", Arial, sans-serif;
        --font-heading: {{ settings.font_heading.family }}, "Heebo", "Segoe UI", Arial, sans-serif;
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; }

      body {
        font-family: var(--font-body);
        line-height: 1.6;
        color: #2a323c;
        min-block-size: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1.75rem;
        padding: clamp(1.25rem, 4vw, 3rem);
        text-align: center;
        background:
          radial-gradient(50rem 28rem at 85% -6%, rgba(var(--accent-rgb), 0.22), transparent 60%),
          linear-gradient(168deg, #1b2129 0%, #12161c 55%, #0d1015 100%);
        -webkit-font-smoothing: antialiased;
      }

      img, svg { display: block; max-inline-size: 100%; }

      .gc-shop {
        font-family: var(--font-heading);
        font-weight: 800;
        font-size: clamp(1.3rem, 4vw, 1.7rem);
        letter-spacing: 0.02em;
        color: #fff;
      }

      .gc-card {
        position: relative;
        inline-size: min(440px, 100%);
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 24px 64px -16px rgba(0, 0, 0, 0.55);
        padding: clamp(1.75rem, 5vw, 2.5rem);
        padding-block-start: calc(clamp(1.75rem, 5vw, 2.5rem) + 6px);
        overflow: hidden;
      }

      .gc-card::before {
        content: "";
        position: absolute;
        inset-block-start: 0;
        inset-inline: 0;
        block-size: 6px;
        background-image: repeating-linear-gradient(-45deg, var(--accent) 0 10px, var(--ink) 10px 20px);
      }

      .gc-title {
        font-family: var(--font-heading);
        font-weight: 800;
        font-size: 1.15rem;
        color: var(--ink);
      }

      .gc-subtext {
        margin-block-start: 0.25rem;
        font-size: 0.92rem;
        color: #6b7683;
      }

      .gc-badge {
        display: inline-block;
        margin-block-start: 0.9rem;
        padding: 0.25rem 0.8rem;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 700;
        background: rgba(217, 48, 37, 0.09);
        color: var(--danger);
        border: 1px solid rgba(217, 48, 37, 0.28);
      }

      .gc-balance {
        margin-block-start: 1.1rem;
        font-family: var(--font-heading);
        font-weight: 800;
        font-size: clamp(2.6rem, 10vw, 3.4rem);
        line-height: 1.1;
        color: var(--ink);
      }

      .gc-balance--expired { color: #9aa4af; text-decoration: line-through; }

      .gc-remaining {
        margin-block-start: 0.35rem;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--success);
      }
      .gc-initial {
        margin-block-start: 0.15rem;
        font-size: 0.85rem;
        color: #9aa4af;
        text-decoration: line-through;
      }

      .gc-code-box {
        margin-block-start: 1.5rem;
        padding: 1.1rem 1.2rem;
        border: 2px dashed rgba(var(--accent-rgb), 0.65);
        border-radius: 10px;
        background: rgba(var(--accent-rgb), 0.06);
      }

      .gc-code-label {
        display: block;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #6b7683;
        margin-block-end: 0.35rem;
      }

      .gc-code {
        display: block;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: clamp(1.15rem, 5vw, 1.45rem);
        font-weight: 700;
        letter-spacing: 0.12em;
        color: var(--ink);
        overflow-wrap: anywhere;
        user-select: all;
      }

      .gc-copy {
        margin-block-start: 0.8rem;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.45rem 1.1rem;
        min-block-size: 38px;
        font: inherit;
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--ink);
        background: transparent;
        border: 1.5px solid var(--ink);
        border-radius: 6px;
        cursor: pointer;
        transition: background-color 150ms ease, color 150ms ease;
      }
      .gc-copy:hover { background: var(--ink); color: #fff; }

      .gc-copy-msg {
        display: block;
        margin-block-start: 0.5rem;
        min-block-size: 1.2em;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--success);
        opacity: 0;
        transition: opacity 200ms ease;
      }
      .gc-copy-msg.is-visible { opacity: 1; }

      .gc-expiry {
        margin-block-start: 1rem;
        font-size: 0.88rem;
        font-weight: 600;
        color: #6b7683;
      }

      .gc-actions {
        margin-block-start: 1.6rem;
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
      }

      .gc-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.8rem 1.6rem;
        min-block-size: 48px;
        font: inherit;
        font-size: 1rem;
        font-weight: 700;
        text-decoration: none;
        border-radius: 6px;
        cursor: pointer;
        transition: filter 150ms ease, background-color 150ms ease, color 150ms ease;
      }

      .gc-btn--primary {
        background: var(--accent);
        color: #fff;
        border: 1.5px solid transparent;
      }
      .gc-btn--primary:hover { filter: brightness(0.94); }

      .gc-btn--ghost {
        background: transparent;
        color: var(--ink);
        border: 1.5px solid #d4d9df;
      }
      .gc-btn--ghost:hover { border-color: var(--ink); }

      .gc-wallet { margin-block-start: 0.35rem; display: inline-block; margin-inline: auto; }

      .gc-footer {
        font-size: 0.85rem;
        color: rgba(244, 245, 247, 0.6);
      }
      .gc-footer a { color: var(--accent); }

      @media print {
        body { background: #fff; color: #000; min-block-size: auto; }
        .gc-card { box-shadow: none; border: 1px solid #ccc; }
        .gc-copy, .gc-copy-msg, .gc-actions, .gc-footer { display: none !important; }
        .gc-shop { color: #000; }
      }
    </style>
  </head>

  <body>
    <header class="gc-shop">{{ shop.name }}</header>

    <main class="gc-card">
      <h1 class="gc-title">{{ 'gift_cards.issued.title' | t }}</h1>
      <p class="gc-subtext">{{ 'gift_cards.issued.subtext' | t: shop: shop.name }}</p>

      {%- if is_expired -%}
        <span class="gc-badge">{{ 'gift_cards.issued.expired' | t }}</span>
      {%- endif -%}

      <p class="gc-balance{% if is_expired %} gc-balance--expired{% endif %}">{{ formatted_balance }}</p>

      {%- if gift_card.balance != gift_card.initial_value -%}
        <p class="gc-remaining">{{ 'gift_cards.issued.remaining_html' | t: balance: formatted_balance }}</p>
        <p class="gc-initial">{{ formatted_initial }}</p>
      {%- endif -%}

      <div class="gc-code-box">
        <span class="gc-code-label" id="GiftCardCodeLabel">{{ 'gift_cards.issued.gift_card_code' | t }}</span>
        <code class="gc-code" id="GiftCardCode" dir="ltr" aria-labelledby="GiftCardCodeLabel">{{ gift_card.code | format_code }}</code>
        <button
          type="button"
          class="gc-copy"
          id="CopyButton"
          data-success="{{ 'gift_cards.issued.copy_code_success' | t | escape }}"
        >
          {{ 'gift_cards.issued.copy_code' | t }}
        </button>
        <span class="gc-copy-msg" id="CopyMessage" role="status" aria-live="polite"></span>
      </div>

      {%- if gift_card.expires_on -%}
        {%- assign expires_date = gift_card.expires_on | date: '%d.%m.%Y' -%}
        <p class="gc-expiry">{{ 'gift_cards.issued.expiration_date' | t: expires_on: expires_date }}</p>
      {%- endif -%}

      <div class="gc-actions">
        {%- unless is_expired -%}
          <a class="gc-btn gc-btn--primary" href="{{ shop.url }}" target="_blank" rel="noopener">
            {{ 'gift_cards.issued.shop_link' | t }}
          </a>
        {%- endunless -%}

        <button type="button" class="gc-btn gc-btn--ghost" id="PrintButton">
          {{ 'gift_cards.issued.print_gift_card' | t }}
        </button>

        {%- if gift_card.pass_url -%}
          <a class="gc-wallet" href="{{ gift_card.pass_url }}">
            <img
              src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
              width="120"
              height="40"
              alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}"
              loading="lazy"
            >
          </a>
        {%- endif -%}
      </div>
    </main>

    <footer class="gc-footer">
      <a href="{{ shop.url }}">{{ shop.name }}</a>
    </footer>

    <script>
      (function () {
        'use strict';

        var copyBtn = document.getElementById('CopyButton');
        var codeEl = document.getElementById('GiftCardCode');
        var msgEl = document.getElementById('CopyMessage');

        function showSuccess() {
          if (!msgEl || !copyBtn) return;
          msgEl.textContent = copyBtn.getAttribute('data-success') || '';
          msgEl.classList.add('is-visible');
          setTimeout(function () {
            msgEl.classList.remove('is-visible');
          }, 2600);
        }

        function fallbackCopy(text) {
          var ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'absolute';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          try {
            document.execCommand('copy');
            showSuccess();
          } catch (err) {
            /* noop */
          }
          document.body.removeChild(ta);
        }

        if (copyBtn && codeEl) {
          copyBtn.addEventListener('click', function () {
            var text = (codeEl.textContent || '').trim();
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(text).then(showSuccess).catch(function () {
                fallbackCopy(text);
              });
            } else {
              fallbackCopy(text);
            }
          });
        }

        var printBtn = document.getElementById('PrintButton');
        if (printBtn) {
          printBtn.addEventListener('click', function () {
            window.print();
          });
        }
      })();
    </script>
  </body>
</html>
