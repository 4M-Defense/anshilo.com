  {
    "name": "טיפוגרפיה",
    "settings": [
      {
        "type": "paragraph",
        "content": "האתר משתמש ב-Heebo לכותרות וב-Assistant לגוף הטקסט. שני הגופנים מאוחסנים בתוך ערכת העיצוב עצמה, כך שהם נטענים מהשרתים של שופיפיי ומהר מאוד — וכוללים תמיכה מלאה בעברית."
      },
      {
        "type": "checkbox",
        "id": "use_shopify_fonts",
        "label": "שימוש בגופני שופיפיי במקום Heebo / Assistant",
        "info": "לא מומלץ. ספריית הגופנים של שופיפיי לא כוללת אותיות עבריות כלל, ולכן סימון האפשרות הזו יגרום לעברית להיראות בגופן ברירת המחדל של המחשב.",
        "default": false
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "גופן גוף הטקסט (שופיפיי)",
        "default": "assistant_n4"
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "גופן כותרות (שופיפיי)",
        "default": "assistant_n7"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "גודל כותרות",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "body_scale",
        "label": "גודל גוף הטקסט",
        "min": 90,
        "max": 115,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "פריסה וסגנון",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "רוחב מקסימלי של התוכן",
