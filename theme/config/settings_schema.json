        "max": 90,
        "step": 5,
        "unit": "יום",
        "default": 30
      },
      {
        "type": "range",
        "id": "low_stock_threshold",
        "label": "רף \"מלאי מוגבל\"",
        "min": 0,
        "max": 20,
        "step": 1,
        "default": 5
      },
      {
        "type": "range",
        "id": "products_per_page",
        "label": "מוצרים בעמוד קטגוריה",
        "min": 12,
        "max": 48,
        "step": 4,
        "default": 24
      }
    ]
  },
  {
    "name": "עגלה וחיפוש",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "סוג העגלה",
