        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1400
      },
      {
        "type": "select",
        "id": "corner_style",
        "label": "עיגול פינות",
        "options": [
          { "value": "sharp", "label": "חד" },
          { "value": "soft", "label": "רך (מומלץ)" },
          { "value": "round", "label": "מעוגל מאוד" }
        ],
        "default": "soft"
      },
      {
        "type": "checkbox",
        "id": "enable_animations",
        "label": "אנימציות ומעברים",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_breadcrumbs",
        "label": "הצגת נתיב ניווט",
        "default": true
      }
    ]
  },
  {
    "name": "כרטיסי מוצר",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "יחס תמונת המוצר",
        "options": [
          { "value": "square", "label": "ריבוע (מומלץ לקטלוג)" },
          { "value": "portrait", "label": "אורך" }
        ],
        "default": "square"
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "הצגת שם המותג",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_second_image",
        "label": "החלפת תמונה במעבר עכבר",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_quick_add",
        "label": "כפתור הוספה מהירה לעגלה",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_stock",
        "label": "חיווי מלאי",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_sale_badge_percent",
        "label": "תגית מבצע באחוזים",
        "default": true
      },
      {
        "type": "range",
        "id": "new_badge_days",
        "label": "תגית \"חדש\" למוצרים מהימים האחרונים",
