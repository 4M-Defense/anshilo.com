{
  "$schema": "https://raw.githubusercontent.com/expo/expo/main/packages/eas-json/schema.json",
  "cli": {
    "//": "environment (למטה) דורש eas-cli חדש. גרסה מפורשת כאן כדי שהשגיאה תהיה 'עדכנו את eas-cli' ולא שדה לא מוכר.",
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "//": "אין channel באף פרופיל בכוונה — channel מגדיר ערוץ עדכוני OTA, והוא דורש את expo-updates שאינו מותקן כאן. הוא היה בקובץ קודם והיה מפיל את הבנייה. אם בעתיד תרצו עדכוני JS בלי אישור מחדש של אפל: npx expo install expo-updates, ואז להחזיר channel.",
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "language": "he-IL"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
