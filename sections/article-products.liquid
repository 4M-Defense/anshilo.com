{%- comment -%}
  Products related to the article, chosen per article in admin through the
  `custom.related_products` metafield.

  This is a standalone section rather than markup inside main-article.liquid so
  that it can be reordered, hidden or removed from the theme editor without a
  code change — and so a merchant can see it in the editor at all.

  The list lives in a metafield rather than inside the article body on purpose:
  the body stays plain prose that anyone can edit without breaking markup, a
  product that is renamed or unpublished drops out on its own instead of
  leaving a dead link mid-sentence, and the cards stay identical to the ones on
  every other page because they come from the same snippet.

  Unavailable products are skipped, and the whole section disappears when
  nothing in the list is buyable — an article should never send a reader to
  something that cannot be bought.
{%- endcomment -%}

{%- if article.metafields.custom.related_products != blank -%}
  {%- assign related = article.metafields.custom.related_products.value -%}
  {%- assign buyable = 0 -%}
  {%- for product in related -%}
    {%- if product != blank and product.available -%}
      {%- assign buyable = buyable | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if buyable > 0 -%}
    <section
      class="section section--tight article-products"
      aria-labelledby="ArticleProducts-{{ section.id }}"
    >
      <div class="container">
        <div class="section-header">
          <div class="section-header__text">
            <h2 class="section-header__heading" id="ArticleProducts-{{ section.id }}">
              {{ section.settings.heading | default: 'מוצרים מהמאמר' | escape }}
            </h2>
          </div>
        </div>

        <div class="grid grid--4">
          {%- for product in related limit: 4 -%}
            {%- if product != blank and product.available -%}
              {% render 'product-card', product: product, lazy: true %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "מוצרים מהמאמר",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "כותרת",
      "default": "מוצרים מהמאמר"
    },
    {
      "type": "paragraph",
      "content": "המוצרים נבחרים לכל מאמר בנפרד, בשדה \"מוצרים קשורים\" שבעריכת המאמר. מוצר שאינו זמין לא יוצג, ואם אף מוצר אינו זמין המדור נעלם."
    }
  ],
  "presets": [{ "name": "מוצרים מהמאמר" }]
}
{% endschema %}
